    <areaTexto>Todas las areas; investigacion; tecnologia; educacion; ciencias sociales</areaTexto>
    <paisTexto>Internacional</paisTexto>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q5094324"/>
    <rdfs:seeAlso rdf:resource="http://www.chevening.org/"/>
