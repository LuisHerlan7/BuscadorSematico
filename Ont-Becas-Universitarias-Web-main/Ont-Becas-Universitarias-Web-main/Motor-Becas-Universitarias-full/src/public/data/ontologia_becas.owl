    <!-- Respaldo offline alineado a las 40 preguntas de competencia del informe. -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologia/becas-universitarias#Offline_Fulbright_Competencia">
        <rdf:type rdf:resource="#BecaDeInvestigación"/>
        <rdfs:label xml:lang="es">Programa Fulbright - Respaldo Offline</rdfs:label>
        <rdfs:label xml:lang="en">Fulbright Program - Offline Backup</rdfs:label>
        <rdfs:label xml:lang="pt">Programa Fulbright - Apoio Offline</rdfs:label>
        <rdfs:label xml:lang="de">Fulbright-Programm - Offline-Sicherung</rdfs:label>
        <rdfs:label xml:lang="fr">Programme Fulbright - Sauvegarde hors ligne</rdfs:label>
        <nombreBeca>Programa Fulbright</nombreBeca>
        <descripción xml:lang="es">Beca internacional de investigación, maestría y doctorado ofrecida por comisiones Fulbright, universidades receptoras y organismos gubernamentales. Responde consultas sobre programas registrados, instituciones participantes, patrocinadores, nivel de posgrado, país destino, colaboración internacional, experiencia de investigación, comités evaluadores, entrevistas, criterios de selección, fechas de convocatoria, duración, postulantes, beneficiarios activos y tasa de aceptación.</descripción>
        <descripción xml:lang="en">International research, master's and doctoral scholarship offered by Fulbright commissions, host universities and government sponsors.</descripción>
        <descripción xml:lang="pt">Bolsa internacional de pesquisa, mestrado e doutorado oferecida por comissões Fulbright, universidades e organismos governamentais.</descripción>
        <descripción xml:lang="de">Internationales Forschungs-, Master- und Promotionsstipendium von Fulbright-Kommissionen, Universitäten und staatlichen Trägern.</descripción>
        <descripción xml:lang="fr">Bourse internationale de recherche, master et doctorat proposée par les commissions Fulbright, universités et organismes publics.</descripción>
        <institucionTexto>Comisión Fulbright; universidades de Estados Unidos; comité evaluador académico internacional</institucionTexto>
        <paisTexto>Estados Unidos; países participantes</paisTexto>
        <nivelTexto>Maestría; Doctorado; Investigación</nivelTexto>
        <areaTexto>Investigación; ciencias sociales; educación; tecnología; salud</areaTexto>
        <montoCubierto>Completa o parcial: matrícula, manutención, seguro médico, pasajes internacionales y materiales de investigación</montoCubierto>
        <fechaLímitePostulación rdf:datatype="&xsd;date">2026-05-31</fechaLímitePostulación>
        <duración rdf:datatype="&xsd;integer">24</duración>
        <requisitosTexto xml:lang="es">Requisitos académicos: licenciatura concluida, promedio mínimo 80/100, certificación TOEFL o IELTS, cartas de recomendación, propuesta de investigación, experiencia académica previa y entrevista. Documentos: pasaporte, certificado académico, carta de motivación y formulario de postulación en línea.</requisitosTexto>
        <beneficiosTexto xml:lang="es">Beneficios: cobertura de matrícula, manutención mensual, alojamiento parcial, transporte internacional, seguro médico, tutoría académica, apoyo para materiales y vinculación con prácticas o intercambio académico.</beneficiosTexto>
        <procesoTexto>Convocatoria anual; revisión documental; evaluación de mérito; prueba o validación de idioma; entrevista; comité evaluador; publicación de resultados en julio; proceso en varias fases; postulación digital.</procesoTexto>
        <estadisticasTexto>Beneficiarios 2024-2026: Ana Flores, Diego Rojas y Laura Méndez; países receptores frecuentes: Estados Unidos y Reino Unido; áreas con mayor concentración: investigación, tecnología y ciencias sociales; postulantes registrados: 120; tasa de aceptación referencial: 12%; becas activas con permanencia por promedio mínimo y reporte semestral.</estadisticasTexto>
        <esRenovable rdf:datatype="&xsd;boolean">true</esRenovable>
        <esRespaldoDBpedia>true</esRespaldoDBpedia>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologia/becas-universitarias#Offline_Erasmus_Competencia">
        <rdf:type rdf:resource="#BecaDeMovilidad"/>
        <rdfs:label xml:lang="es">Beca Erasmus+ - Respaldo Offline</rdfs:label>
