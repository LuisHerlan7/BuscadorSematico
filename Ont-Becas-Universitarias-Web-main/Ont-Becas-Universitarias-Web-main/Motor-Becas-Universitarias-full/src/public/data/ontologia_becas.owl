    <nivelTexto>Language Training, Undergraduate, Master's</nivelTexto>
    <requisitosTexto>Buen estado de salud, excelente expediente académico</requisitosTexto>
    <esRespaldoDBpedia>true</esRespaldoDBpedia>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologia/becas-universitarias#Scholarship_7">
