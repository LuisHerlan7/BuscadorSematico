  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologia/becas-universitarias#Scholarship_1">
    <rdfs:label xml:lang="es">Programa Fulbright</rdfs:label>
    <rdfs:label xml:lang="en">Fulbright Programme</rdfs:label>
    <descripción xml:lang="es">Programa de becas internacionales para estudiantes y profesionales estadounidenses que deseen estudiar o investigar en el extranjero. Especialización y maestría en universidades de prestigio. Oportunidad de especialización profesional.</descripción>
    <descripción xml:lang="en">International scholarship program for American students and professionals to study or conduct research abroad.</descripción>
    <paisTexto>United States</paisTexto>
    <nivelTexto>Master&apos;s, PhD</nivelTexto>
    <requisitosTexto>Diploma de licenciatura, dominio de inglés, expediente académico excelente</requisitosTexto>
    <esRespaldoDBpedia>true</esRespaldoDBpedia>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologia/becas-universitarias#Scholarship_2">
    <rdfs:label xml:lang="es">Beca Erasmus+</rdfs:label>
    <rdfs:label xml:lang="en">Erasmus+ Scholarship</rdfs:label>
    <descripción xml:lang="es">Programa europeo de becas para movilidad educativa en educación superior, formación profesional y aprendizaje permanente. Estudios de especialización en España y otros países europeos.</descripción>
    <descripción xml:lang="en">European scholarship program for educational mobility in higher education, vocational training and lifelong learning.</descripción>
    <paisTexto>European Union, Spain</paisTexto>
    <nivelTexto>Undergraduate, Master&apos;s</nivelTexto>
    <requisitosTexto>Ser ciudadano de país participante, estar matriculado en institución de educación superior</requisitosTexto>
    <esRespaldoDBpedia>true</esRespaldoDBpedia>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologia/becas-universitarias#Scholarship_3">
    <rdfs:label xml:lang="es">Beca DAAD</rdfs:label>
    <rdfs:label xml:lang="en">DAAD Scholarship</rdfs:label>
    <descripción xml:lang="es">Servicio Alemán de Intercambio Académico. Becas para estudiantes y académicos internacionales de todas las disciplinas para estudiar en Alemania. Programas de maestría y especialización.</descripción>
    <descripción xml:lang="en">German Academic Exchange Service scholarships for international students and academics to study in Germany.</descripción>
    <paisTexto>Germany</paisTexto>
    <nivelTexto>Undergraduate, Master&apos;s, PhD, Research</nivelTexto>
    <requisitosTexto>Candidato con excelente expediente académico, dominio del idioma alemán o inglés</requisitosTexto>
    <esRespaldoDBpedia>true</esRespaldoDBpedia>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologia/becas-universitarias#Scholarship_4">
    <rdfs:label xml:lang="es">Beca Rhodes</rdfs:label>
    <rdfs:label xml:lang="en">Rhodes Scholarship</rdfs:label>
    <descripción xml:lang="es">Una de las becas internacionales más prestigiosas para estudiantes graduados de universidades seleccionadas para estudiar en la Universidad de Oxford. Maestría en universidades británicas.</descripción>
    <descripción xml:lang="en">One of the most prestigious international scholarships for graduate students to study at Oxford University.</descripción>
    <paisTexto>United Kingdom, Oxford</paisTexto>
    <nivelTexto>Master&apos;s, Post-doctoral</nivelTexto>
    <requisitosTexto>Licenciado, capacidad intelectual excepcional, ciudadanía calificada</requisitosTexto>
    <esRespaldoDBpedia>true</esRespaldoDBpedia>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologia/becas-universitarias#Scholarship_5">
    <rdfs:label xml:lang="es">Beca Chevening</rdfs:label>
    <rdfs:label xml:lang="en">Chevening Scholarship</rdfs:label>
    <descripción xml:lang="es">Programa de becas del Gobierno del Reino Unido para líderes del futuro de países en todo el mundo que deseen estudiar en universidades británicas. Especialización profesional en Reino Unido.</descripción>
    <descripción xml:lang="en">UK Government scholarship program for future leaders worldwide to study at British universities.</descripción>
    <paisTexto>United Kingdom</paisTexto>
    <nivelTexto>Master&apos;s</nivelTexto>
    <requisitosTexto>Mínimo 2 años de experiencia laboral, dominio de inglés demostrado</requisitosTexto>
    <esRespaldoDBpedia>true</esRespaldoDBpedia>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologia/becas-universitarias#Scholarship_6">
    <rdfs:label xml:lang="es">Beca del Instituto Confucio</rdfs:label>
    <rdfs:label xml:lang="en">Confucius Institute Scholarship</rdfs:label>
    <descripción xml:lang="es">Becas del Gobierno Chino para estudiantes internacionales para estudiar chino y otros programas académicos en universidades chinas. Programas de especialización y maestría.</descripción>
    <descripción xml:lang="en">Chinese Government scholarships for international students to study Chinese language and academic programs in Chinese universities.</descripción>
    <paisTexto>China</paisTexto>
    <nivelTexto>Language Training, Undergraduate, Master&apos;s</nivelTexto>
    <requisitosTexto>Buen estado de salud, excelente expediente académico</requisitosTexto>
    <esRespaldoDBpedia>true</esRespaldoDBpedia>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologia/becas-universitarias#Scholarship_7">
    <rdfs:label xml:lang="es">Becas Carolina</rdfs:label>
    <rdfs:label xml:lang="en">Carolina Scholarships</rdfs:label>
    <descripción xml:lang="es">Programa de becas para profesionales y estudiantes de América Latina, el Caribe y Portugal para estudios en universidades españolas. Maestría y especialización en España.</descripción>
    <descripción xml:lang="en">Scholarship program for professionals and students from Latin America, the Caribbean and Portugal to study at Spanish universities.</descripción>
    <paisTexto>Spain, Latin America</paisTexto>
    <nivelTexto>Master&apos;s, PhD, Research</nivelTexto>
    <requisitosTexto>Tener nacionalidad de país beneficiario, máster o licenciatura, conocimiento de español</requisitosTexto>
    <esRespaldoDBpedia>true</esRespaldoDBpedia>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologia/becas-universitarias#Scholarship_8">
    <rdfs:label xml:lang="es">Beca Fundación Carolina</rdfs:label>
    <rdfs:label xml:lang="en">Carolina Foundation Scholarship</rdfs:label>
    <descripción xml:lang="es">Becas para jóvenes profesionales iberoamericanos para realizar posgrados y programas de especialización en universidades españolas. Maestría y especialización profesional.</descripción>
    <descripción xml:lang="en">Scholarships for young Ibero-American professionals to pursue postgraduate studies and specialization programs at Spanish universities.</descripción>
    <paisTexto>Spain, Iberoamerica</paisTexto>
